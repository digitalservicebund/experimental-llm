# LiteLLM environment file with 1Password secret references
# This file is read by the systemd service to populate environment variables
# Each variable can reference 1Password items using op:// paths

# Master key for securing the /key/generate endpoint
# Used to generate Virtual Keys post-deployment via:
#   curl -X POST http://127.0.0.1:4000/key/generate \
#     -H "Authorization: Bearer <MASTER_KEY>" \
#     -H "Content-Type: application/json" \
#     -d '{"key_alias": "test_key_1"}'
LITELLM_MASTER_KEY={{ litellm_master_key }}

# PostgreSQL connection string for persistent key storage
DATABASE_URL="postgresql://{{ litellm_db_user }}:{{ litellm_db_password }}@{{ litellm_db_host }}:{{ litellm_db_port }}/{{ litellm_db_name }}"

