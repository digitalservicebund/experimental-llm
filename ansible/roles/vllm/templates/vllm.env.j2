MODEL={{ llm_model }}
HF_HOME={{ llm_model_cache_dir }}
VLLM_API_KEY={{ llm_api_key }}
# vLLM JIT-compiles kernels at runtime; nvcc ships inside the torch CUDA wheels.
CUDA_HOME={{ vllm_site_packages.stdout }}/nvidia/cu13
# FlashInfer's bundled cccl headers clash with the cu13 nvcc, so its sampler
# kernels fail to build. Fall back to the native PyTorch sampler.
VLLM_USE_FLASHINFER_SAMPLER=0
{% if llm_huggingface_token | length > 0 %}
HF_TOKEN={{ llm_huggingface_token }}
{% endif %}